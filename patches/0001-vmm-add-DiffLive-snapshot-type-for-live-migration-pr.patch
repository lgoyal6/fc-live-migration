+    #[test]
+    fn test_dump_dirty_live_budget() {
+        let page_size = host_page_size();
+
+        // One region, four pages, all dirty in the firecracker bitmap.
+        let region_size = page_size * 4;
+        let guest_memory = into_region_ext(
+            anonymous(
+                [(GuestAddress(0), region_size)].into_iter(),
+                true,
+                HugePageConfig::None,
+            )
+            .unwrap(),
+        );
+        guest_memory
+            .write(&vec![7u8; region_size], GuestAddress(0))
+            .unwrap();
+        let mut kvm_dirty_bitmap: DirtyBitmap = HashMap::new();
+        kvm_dirty_bitmap.insert(0, vec![0b0000]);
+
+        // Budget of two pages: the dump must contain exactly two pages of
+        // data, drain those two from the bitmap, and keep the other two
+        // marked as backlog.
+        let mut file = TempFile::new().unwrap().into_file();
+        guest_memory
+            .dump_dirty_live(&mut file, &kvm_dirty_bitmap, Some(2 * page_size as u64))
+            .unwrap();
+        assert_eq!(
+            file.metadata().unwrap().blocks() * 512,
+            2 * page_size as u64
+        );
+        guest_memory.iter().for_each(|r| {
+            assert!(!r.bitmap().dirty_at(0));
+            assert!(!r.bitmap().dirty_at(page_size));
+            assert!(r.bitmap().dirty_at(2 * page_size));
+            assert!(r.bitmap().dirty_at(3 * page_size));
+        });
+        assert_eq!(
+            guest_memory.dirty_backlog_bytes(),
+            2 * page_size as u64,
+            "backlog accounting should match the two undumped pages"
+        );
+
+        // A follow-up with a clean KVM bitmap drains exactly the backlog.
+        let mut clean_kvm: DirtyBitmap = HashMap::new();
+        clean_kvm.insert(0, vec![0b0000]);
+        let mut file2 = TempFile::new().unwrap().into_file();
+        guest_memory
+            .dump_dirty_live(&mut file2, &clean_kvm, None)
