+    /// Like [`Self::dump_dirty`], but safe to call while vCPUs are running
+    /// (a live-migration pre-copy round), and bounded: at most `max_bytes`
+    /// of memory are dumped per call.
+    ///
+    /// Dirty pages beyond the budget are not lost — they are collected into
+    /// a leftover bitmap, and after the dump the VMM-internal bitmap is
+    /// reset and re-marked with exactly that leftover. The bitmap therefore
+    /// doubles as the drain backlog: each call dumps up to `max_bytes` of
+    /// it and the backlog shrinks monotonically (modulo new writes). An
+    /// earlier design that merely re-marked over-budget pages without the
+    /// reset never converged: the backlog stayed in the bitmap forever, so
+    /// every round re-dumped the same pages and re-write-protected the
+    /// whole backlog via the next dirty-log fetch, throttling the guest.
+    ///
+    /// Safety of read-then-reset: VMM-side guest-memory writes (virtio
+    /// queue processing, MMDS) are executed by the same event-loop thread
+    /// that runs this dump, so no VMM mark can race the reset. Guest (vCPU)
+    /// writes are covered by KVM's fetch-and-clear dirty log: a write
+    /// racing this dump lands either in the bitmap fetched for this round —
+    /// its page is dumped below, possibly torn mid-write — or in KVM's
+    /// fresh bitmap, so the page is re-dumped next round. Torn pages are
+    /// therefore always re-marked dirty, and the final paused pass is
+    /// consistent.
+    fn dump_dirty_live<T: WriteVolatile + std::io::Seek>(
+        &self,
+        writer: &mut T,
+        dirty_bitmap: &DirtyBitmap,
+        max_bytes: Option<u64>,
+    ) -> Result<(), MemoryError> {
+        let page_size = host_page_size();
+        let mut remaining = max_bytes.unwrap_or(u64::MAX);
+        let mut leftover = DirtyBitmap::new();
+        let write_result = dump_dirty_pages(
+            self,
+            writer,
+            dirty_bitmap,
+            page_size,
+            Some((&mut remaining, &mut leftover)),
+        );
+
+        match write_result {
+            Ok(()) => {
+                // Every dirty page was either dumped or recorded in
+                // `leftover`; the bitmap now tracks exactly the backlog.
+                self.reset_dirty();
+                self.store_dirty_bitmap(&leftover, page_size);
+            }
+            Err(_) => {
+                // The KVM bits were consumed by the fetch; merge them back
+                // so a later snapshot still sees these pages (same recovery
+                // as dump_dirty).
+                self.store_dirty_bitmap(dirty_bitmap, page_size);
+            }
+        }
+
+        write_result
+    }
+
+    fn dirty_backlog_bytes(&self) -> u64 {
+        let page_size = host_page_size();
+        self.iter()
+            .flat_map(|region| region.plugged_slots())
+            .map(|mem_slot| {
+                let bitmap = mem_slot.slice.bitmap();
+                (0..mem_slot.slice.len())
+                    .step_by(page_size)
+                    .filter(|&off| bitmap.dirty_at(off))
+                    .count() as u64
+                    * page_size as u64
+            })
+            .sum()
+    }
